---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { formatDate, getPosts, postSlug, readingMinutes, type Post } from '../../lib/posts';
import { withBase } from '../../lib/urls';
import { CATEGORY_LABELS } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getPosts();
const currentIndex = posts.findIndex((item) => item.id === post.id);
const newerPost = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const olderPost = currentIndex < posts.length - 1 ? posts[currentIndex + 1] : undefined;
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishDate.toISOString()} />
    {post.data.updatedDate && <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <div class="article-shell">
    <div class="article-grid">
      <article class="article-main">
        <header class="article-header">
          <p class="eyebrow">{CATEGORY_LABELS[post.data.category]}{post.data.draft ? ' / 草稿预览' : ''}</p>
          <h1>{post.data.title}</h1>
          <p class="article-description">{post.data.description}</p>
          <div class="article-meta">
            <span>发布 <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time></span>
            {post.data.updatedDate && <span>更新 <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>}
            <span>{readingMinutes(post)} 分钟阅读</span>
          </div>
          <div class="article-tags" aria-label="文章标签">
            {post.data.tags.map((tag) => <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}
          </div>
        </header>
        {headings.length > 0 && (
          <details class="mobile-toc"><summary>文章目录</summary><TableOfContents headings={headings} /></details>
        )}
        <div class="prose"><Content /></div>
        <nav class="post-navigation" aria-label="相邻文章">
          {olderPost ? <a href={withBase(`/posts/${postSlug(olderPost)}/`)}><span>上一篇</span><strong>{olderPost.data.title}</strong></a> : <span></span>}
          {newerPost && <a href={withBase(`/posts/${postSlug(newerPost)}/`)}><span>下一篇</span><strong>{newerPost.data.title}</strong></a>}
        </nav>
      </article>
      <aside class="article-aside"><TableOfContents headings={headings} /></aside>
    </div>
  </div>
</BaseLayout>
