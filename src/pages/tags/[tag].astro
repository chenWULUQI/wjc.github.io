---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

interface Props { tag: string }
const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`标签：${tag}`} description={`浏览标签“${tag}”下的全部文章。`}>
  <div class="page-shell reading-column">
    <header class="page-header">
      <p class="eyebrow">Tag / {posts.length}</p>
      <h1>#{tag}</h1>
      <p>收录在这个主题下的文章。</p>
    </header>
    <PostList posts={posts} />
  </div>
</BaseLayout>
